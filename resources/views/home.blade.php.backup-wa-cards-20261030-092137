@php
    $regionalService = resolve(App\Services\RegionalService::class);
    $provinces = $regionalService->getAllProvinces();

    $allPrograms = app(\App\Services\SchemeService::class)->all();

    /*
     * Kelompokkan berdasarkan kategori asli dari layanan.json.
     * Tidak menggunakan empat kelompok presentasi lama.
     */
    $categories = collect($allPrograms)
        ->groupBy(fn ($item) => $item['category_label'] ?? 'Layanan Lainnya')
        ->map(function ($items, $categoryName) {
            return [
                'name' => $categoryName,
                'slug' => \Illuminate\Support\Str::slug($categoryName),
                'items' => $items,
                'count' => $items->count(),
            ];
        })
        ->sortBy('name')
        ->values();

    $totalServices = count($allPrograms);
    $totalCategories = $categories->count();

    $latestArticles = collect();

    if (\Illuminate\Support\Facades\Schema::hasTable('articles')) {
        $latestArticles = \App\Models\Article::published()
            ->orderBy('published_at', 'desc')
            ->take(4)
            ->get();
    }
@endphp

